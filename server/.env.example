############################################
# ExpenseWise Server Environment Variables #
############################################

# Express server port
PORT=5000

# Persistent MongoDB connection string
# Local default:
MONGO_URI=mongodb://localhost:27017/expensewise
# Atlas example (replace placeholders):
# MONGO_URI=mongodb+srv://<user>:<pass>@<cluster-id>.mongodb.net/expensewise?retryWrites=true&w=majority

# JWT signing secret (generate a long random hex string)
# Example (PowerShell):
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_secure_random_string

# Allow ephemeral in-memory fallback if Mongo fails (true/false)
USE_INMEMORY_ON_FAIL=false

# Node environment
NODE_ENV=development

# Copy this file to .env and edit values before running the server.
